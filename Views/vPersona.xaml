<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dGomezS5.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout
        Padding="15"
        Spacing="15">
       
        <Label 
            Text="Semana 5:SQLITE"
            
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry
            x:Name="txtNombre"
            Placeholder="Ingresa el nombre"></Entry>
        <Grid Padding="5" RowSpacing="1" ColumnSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button
                x:Name="btnAgregar"
                Text="Agregar Persona"
                Clicked="btnAgregar_Clicked"
                Grid.Row="0"
                Grid.Column="0"></Button>
            <Label x:Name="lblMessage"
                   TextColor="Green"
                   Grid.Row="1"
                   Grid.Column="0"></Label>
            <Button
                x:Name="btnMostrar"
                Text="Mostrar Personas: "
                Clicked="btnMostrar_Clicked"
                Grid.Row="2"
                Grid.Column="1"></Button>
            <CollectionView
                x:Name="ListaPersonas"
                Grid.Row="3"
                Grid.Column="0">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Id}"
                               Grid.Row="0"
                               Grid.Column="0"></Label>
                            <Label Text="{Binding Name}"
                               Grid.Row="0"
                               Grid.Column="1"></Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button
                x:Name="btnEliminar"
                Text="Eliminar Persona "
                Clicked="btnEliminar_Clicked"
                Grid.Row="4"
                Grid.Column="0">
            </Button>
            <Button
                x:Name="btnEditar"
                Text="Editar Persona "
                Clicked="btnEditar_Clicked"
                Grid.Row="5"
                Grid.Column="0">
            </Button>
        </Grid>
    </VerticalStackLayout>
</ContentPage>